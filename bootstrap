#!/usr/bin/env sh
#  Copyright (C) 2026 Kamila Szewczyk.  GPLv3-only.
#
#  Fetch pinned single-header dependencies, then regenerate the
#  autotools build.  Each dependency is pinned to an upstream commit
#  hash and verified by SHA-256.  A file that is already present and
#  matches its hash is left untouched, so building from a release
#  tarball (or offline) needs no network.
set -e

cd "$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"

#  Pick a downloader and a SHA-256 hasher once.
if   command -v curl >/dev/null 2>&1; then DL=curl
elif command -v wget >/dev/null 2>&1; then DL=wget
else echo "bootstrap: need curl or wget to fetch dependencies" >&2; exit 1
fi
if   command -v sha256sum >/dev/null 2>&1; then HASH="sha256sum"
elif command -v shasum    >/dev/null 2>&1; then HASH="shasum -a 256"
else echo "bootstrap: need sha256sum or shasum" >&2; exit 1
fi

hash_file() { $HASH "$1" | cut -d' ' -f1; }

#  fetch_dep <owner/repo> <commit> <path-in-repo> <dest> <sha256>
fetch_dep() {
  _repo=$1; _commit=$2; _src=$3; _dest=$4; _want=$5
  if [ -f "$_dest" ] && [ "$(hash_file "$_dest")" = "$_want" ]; then
    echo "bootstrap: $_dest present and verified"
    return 0
  fi
  _url="https://raw.githubusercontent.com/$_repo/$_commit/$_src"
  _tmp="$_dest.tmp.$$"
  echo "bootstrap: fetching $_repo@$_commit -> $_dest"
  mkdir -p "$(dirname -- "$_dest")"
  case $DL in
    curl) curl -fsSL "$_url" -o "$_tmp" ;;
    wget) wget -qO   "$_tmp" "$_url"    ;;
  esac
  _got=$(hash_file "$_tmp")
  if [ "$_got" != "$_want" ]; then
    echo "bootstrap: SHA-256 mismatch for $_dest" >&2
    echo "  expected $_want" >&2
    echo "  got      $_got"  >&2
    rm -f "$_tmp"
    exit 1
  fi
  mv -f "$_tmp" "$_dest"
  echo "bootstrap: $_dest verified OK"
}

#  --- pinned dependencies ---------------------------------------------
#  yarg: single-header command-line argument parser, by the same
#  author.  Used by cli.c; lives at the source-tree root.
fetch_dep iczelia/yarg \
  adc3050ecdeef3118c75bd81a0b5294b20b3d88f \
  yarg.h \
  yarg.h \
  4e82adf605225d129b284b1c0cf39042ca9628dc35571146f2b0617da769bffc
#  ---------------------------------------------------------------------

autoreconf --install
